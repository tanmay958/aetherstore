# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# See docs/STORAGE.md for where each value comes from.

# --- Cloudflare R2 (recommended: 10GB, 10M reads/month, zero egress, no expiry)
# R2 API tokens issued by Cloudflare. Not AWS credentials; no AWS account is
# involved. Dashboard -> R2 -> Manage R2 API Tokens -> Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
AETHER_TEST_R2_BUCKET=aether

# --- MinIO, for local development (make up)
# AETHER_S3_ENDPOINT=http://localhost:9000
# AWS_ACCESS_KEY_ID=aether
# AWS_SECRET_ACCESS_KEY=aethersecret

# --- AWS S3
# Leave AETHER_S3_ENDPOINT unset for real AWS.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
